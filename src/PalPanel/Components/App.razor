<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="tokens.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="PalPanel.styles.css" />
    <script>
        // Apply the persisted theme choice before first paint to avoid a flash. An absent
        // choice leaves prefers-color-scheme in control (no data-theme attribute).
        (function () {
            try {
                var t = localStorage.getItem('palpanel-theme');
                if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
            } catch (e) { /* storage blocked; fall back to OS preference */ }
        })();
        window.palTheme = {
            toggle: function () {
                var cur = document.documentElement.getAttribute('data-theme');
                // Resolve the effective theme first so the first toggle always flips visibly.
                if (!cur) cur = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                var next = cur === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                try { localStorage.setItem('palpanel-theme', next); } catch (e) { }
                return next;
            }
        };
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        // Extend the client-side reconnect budget (default is ~8 quick retries) so a tunnel
        // blip doesn't exhaust retries and strand the user on "Failed to rejoin". We do NOT
        // pass a custom reconnectionHandler — omitting it keeps Blazor's built-in reconnect
        // modal (#components-reconnect-modal, see ReconnectModal.razor), which already shows
        // Retry + reload messaging. Server-side circuit retention (Program.cs) lets these
        // retries resume the SAME circuit rather than reset component state.
        Blazor.start({
            circuit: {
                reconnectionOptions: { maxRetries: 30, retryIntervalMilliseconds: 3000 }
            }
        });
    </script>
    <script src="lib/chart.umd.js"></script>
    <script src="js/charts.js"></script>
</body>

</html>
