@page "/s/{Id:guid}/settings"
@using Cronos
@using Microsoft.EntityFrameworkCore
@using PalPanel.Auth
@using PalPanel.Control
@using PalPanel.Data
@using PalPanel.PalApi
@using PalPanel.Servers
@inject IDbContextFactory<PanelDb> DbFactory
@inject ServerManager Manager
@inject IEventSink Events
@inject AuthenticationStateProvider AuthState
@inject IAdminGuard Guard
@rendermode InteractiveServer

<PageTitle>PalPanel — @(_rt?.Config.Name ?? "Server") Settings</PageTitle>

@if (_rt is null)
{
    <ServerNotFound />
}
else
{
<AuthorizeView Roles="Admin">
    <Authorized>

        <h1>@_rt.Config.Name — Settings</h1>

        <h2>Schedules</h2>
        @if (_scheduleError is not null)
        {
            <div class="alert">@_scheduleError</div>
        }
        <table class="data-table">
            <thead><tr><th>Cron</th><th>Action</th><th>Enabled</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in _schedules)
                {
                    <tr>
                        <td>@s.Cron</td>
                        <td>@s.Action</td>
                        <td><input type="checkbox" checked="@s.Enabled" @onchange="() => ToggleEnabledAsync(s)" /></td>
                        <td><button @onclick="() => DeleteScheduleAsync(s)">Delete</button></td>
                    </tr>
                }
                @if (_schedules.Count == 0)
                {
                    <tr><td colspan="4">No schedules configured.</td></tr>
                }
            </tbody>
        </table>

        <div class="actions">
            <input placeholder="Cron expression, e.g. 0 4 * * *" @bind="_newCron" @bind:event="oninput" />
            <select @bind="_newAction">
                <option value="restart">restart</option>
                <option value="backup">backup</option>
            </select>
            <button @onclick="AddScheduleAsync">Add schedule</button>
        </div>

        <h2>Auto-restart</h2>
        <p class="stat-sub">Restart this server automatically when it stops responding or uses too much memory. Set 0 to turn a trigger off. Changes apply immediately — no need to stop the server.</p>
        @if (_autoNotice is not null)
        {
            <div class="notice ok"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>@_autoNotice</div>
        }
        <div class="form-grid">
            <label>Restart if API unreachable for (minutes)<input type="number" min="0" @bind="_arUnreachable" /></label>
            <label>Restart if memory exceeds (GB)<input type="number" min="0" step="0.5" @bind="_arMemGb" /></label>
        </div>
        <div class="actions">
            <button class="primary" @onclick="SaveAutoRestartAsync">Save auto-restart</button>
        </div>

        <h2>Launch arguments</h2>
        <p class="stat-sub">Arguments the panel passes when it starts or auto-restarts the server. Editable while running (they only affect the next launch). Match your Steam launch options so a panel-started server is configured the same.</p>
        @if (_launchNotice is not null)
        {
            <div class="notice ok"><svg viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>@_launchNotice</div>
        }
        <div class="send-box">
            <input @bind="_launchArgs" @bind:event="oninput" placeholder="-port=8211 -players=32 -publiclobby -UseMultithreadForDS" />
            <button class="primary" @onclick="SaveLaunchArgsAsync">Save launch args</button>
        </div>

        <h2>Diagnostics</h2>
        <table class="data-table">
            <tbody>
                <tr><td>Server executable</td><td>@_rt.Config.ExePath</td></tr>
                <tr><td>Launch args</td><td>@_rt.Config.LaunchArgs</td></tr>
                <tr><td>Save directory</td><td>@_rt.Config.SaveDirectory</td></tr>
                <tr><td>Backup directory</td><td>@_rt.Config.BackupDirectory</td></tr>
                <tr><td>Backups to keep</td><td>@_rt.Config.BackupsToKeep</td></tr>
                <tr><td>REST API base URL</td><td>@_rt.Config.ApiBaseUrl</td></tr>
            </tbody>
        </table>

        <div class="actions">
            <button disabled="@_apiTestBusy" @onclick="TestApiAsync">Test REST API</button>
            <a href="@($"/servers/{Id}/edit")">Edit configuration</a>
        </div>
        @if (_apiTestResult is not null)
        {
            <p class="stat-sub">@_apiTestResult</p>
        }

    </Authorized>
    <NotAuthorized>
        <p>Admin access required.</p>
    </NotAuthorized>
</AuthorizeView>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ServerRuntime? _rt;
    private List<Schedule> _schedules = [];
    private string _email = "";
    private string? _scheduleError;
    private string _newCron = "";
    private string _newAction = "restart";
    private bool _apiTestBusy;
    private string? _apiTestResult;
    private int _arUnreachable;
    private double _arMemGb;
    private string? _autoNotice;
    private string _launchArgs = "";
    private string? _launchNotice;

    protected override async Task OnInitializedAsync()
    {
        _rt = Manager.Get(Id);
        if (_rt is null) return;
        var auth = await AuthState.GetAuthenticationStateAsync();
        _email = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "unknown";
        _arUnreachable = _rt.Config.AutoRestartUnreachableMinutes;
        _arMemGb = _rt.Config.AutoRestartMemoryGb;
        _launchArgs = _rt.Config.LaunchArgs;
        await LoadSchedulesAsync();
    }

    private async Task SaveLaunchArgsAsync()
    {
        _launchNotice = null;
        try
        {
            await Guard.EnsureAdminAsync(_email, "launch-args", CancellationToken.None);
            await Manager.UpdateLaunchArgsAsync(Id, _launchArgs);
            _launchNotice = "Launch args saved — used on the next start/restart.";
        }
        catch (Exception ex) { _launchNotice = $"Couldn't save: {ex.Message}"; }
    }

    private async Task SaveAutoRestartAsync()
    {
        _autoNotice = null;
        try
        {
            await Guard.EnsureAdminAsync(_email, "auto-restart-config", CancellationToken.None);
            await Manager.UpdateAutoRestartAsync(Id, _arUnreachable, _arMemGb);
            _autoNotice = "Auto-restart settings saved.";
        }
        catch (Exception ex) { _autoNotice = $"Couldn't save: {ex.Message}"; }
    }

    private async Task LoadSchedulesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _schedules = await db.Schedules.Where(s => s.ServerId == Id).OrderBy(s => s.Id).ToListAsync();
    }

    private async Task AddScheduleAsync()
    {
        _scheduleError = null;
        if (string.IsNullOrWhiteSpace(_newCron))
        {
            _scheduleError = "Cron expression is required.";
            return;
        }
        try { CronExpression.Parse(_newCron); }
        catch (Exception ex)
        {
            _scheduleError = $"Invalid cron expression '{_newCron}': {ex.Message}";
            return;
        }

        try
        {
            await Guard.EnsureAdminAsync(_email, "schedule-change", CancellationToken.None);
            await using var db = await DbFactory.CreateDbContextAsync();
            var s = new Schedule { ServerId = Id, Cron = _newCron, Action = _newAction, Enabled = true };
            db.Schedules.Add(s);
            await db.SaveChangesAsync();
            await Events.LogAsync("schedule-change", $"Added schedule {s.Cron} -> {s.Action} on {_rt!.Config.Name}", _email);
            _newCron = "";
            await LoadSchedulesAsync();
        }
        catch (UnauthorizedAccessException ex) { _scheduleError = ex.Message; }
    }

    private async Task ToggleEnabledAsync(Schedule s)
    {
        _scheduleError = null;
        try
        {
            await Guard.EnsureAdminAsync(_email, "schedule-change", CancellationToken.None);
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.Schedules.FindAsync(s.Id);
            if (row is null || row.ServerId != Id) return;
            row.Enabled = !row.Enabled;
            await db.SaveChangesAsync();
            await Events.LogAsync("schedule-change", $"Schedule {row.Id} ({row.Cron}/{row.Action}) enabled={row.Enabled}", _email);
            await LoadSchedulesAsync();
        }
        catch (UnauthorizedAccessException ex) { _scheduleError = ex.Message; }
    }

    private async Task DeleteScheduleAsync(Schedule s)
    {
        _scheduleError = null;
        try
        {
            await Guard.EnsureAdminAsync(_email, "schedule-change", CancellationToken.None);
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.Schedules.FindAsync(s.Id);
            if (row is null || row.ServerId != Id) return;
            db.Schedules.Remove(row);
            await db.SaveChangesAsync();
            await Events.LogAsync("schedule-change", $"Deleted schedule {row.Id} ({row.Cron}/{row.Action})", _email);
            await LoadSchedulesAsync();
        }
        catch (UnauthorizedAccessException ex) { _scheduleError = ex.Message; }
    }

    private async Task TestApiAsync()
    {
        _apiTestBusy = true;
        _apiTestResult = null;
        try
        {
            var info = await _rt!.Api.GetInfoAsync(CancellationToken.None);
            _apiTestResult = info is null
                ? "No response from REST API."
                : $"OK — version {info.Version}, server \"{info.ServerName}\"";
        }
        catch (Exception ex) { _apiTestResult = $"Failed: {ex.Message}"; }
        finally { _apiTestBusy = false; }
    }
}
