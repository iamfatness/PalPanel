@page "/s/{Id:guid}/backups"
@using PalPanel.Auth
@using PalPanel.Control
@using PalPanel.Servers
@using PalPanel.Supervisor
@implements IDisposable
@inject ServerManager Manager
@inject AuthenticationStateProvider AuthState
@inject IAdminGuard Guard
@rendermode InteractiveServer

<PageTitle>PalPanel — Backups</PageTitle>

@if (_rt is null)
{
    <ServerNotFound />
}
else
{
<AuthorizeView Roles="Admin">
    <Authorized>

        <h1>Backups</h1>

        @if (_error is not null)
        {
            <div class="alert">@_error</div>
        }

        <div class="actions">
            <button disabled="@_busy" @onclick="BackUpNowAsync">Back up now</button>
        </div>

        @if (_state != ServerState.Stopped)
        {
            <p class="stat-sub">Restore is only available while the server is stopped (current state: @_state).</p>
        }

        <table class="data-table">
            <thead>
                <tr><th>File</th><th>Size (MB)</th><th>Created</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var b in _backups)
                {
                    <tr>
                        <td>@b.FileName</td>
                        <td>@((b.SizeBytes / 1_048_576.0).ToString("0.0"))</td>
                        <td>@b.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            <a href="@($"/backups/download/{Id}/{b.FileName}")">Download</a>
                            <button disabled="@(_busy || _state != ServerState.Stopped)"
                                    @onclick="() => ConfirmRestoreAsync(b)">Restore</button>
                        </td>
                    </tr>
                }
                @if (_backups.Count == 0)
                {
                    <tr><td colspan="4">No backups yet.</td></tr>
                }
            </tbody>
        </table>

        <ConfirmDialog @ref="_confirm" />

    </Authorized>
    <NotAuthorized>
        <p>Admin access required.</p>
    </NotAuthorized>
</AuthorizeView>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ServerRuntime? _rt;
    private IReadOnlyList<BackupInfo> _backups = [];
    private ServerState _state;
    private string _email = "";
    private bool _busy;
    private string? _error;
    private ConfirmDialog _confirm = null!;

    private IBackupService BackupSvc => _rt!.Backups;

    protected override async Task OnInitializedAsync()
    {
        _rt = Manager.Get(Id);
        if (_rt is null) return;
        _state = _rt.Supervisor.State;
        _rt.Supervisor.StateChanged += OnStateChanged;
        var auth = await AuthState.GetAuthenticationStateAsync();
        _email = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "unknown";
        Refresh();
    }

    private void Refresh() => _backups = BackupSvc.List();

    private void OnStateChanged(ServerState s)
    {
        InvokeAsync(() => { _state = s; StateHasChanged(); });
    }

    private async Task BackUpNowAsync()
    {
        _busy = true; _error = null;
        try
        {
            // Server-side authorization backstop: <AuthorizeView Roles="Admin"> above only
            // hides the button — it is not a security boundary on its own. IBackupService
            // is called internally by the scheduler/orchestrator (already guarded upstream),
            // so the guard belongs here, at the UI-triggered entry point, not inside the
            // service itself.
            await Guard.EnsureAdminAsync(_email, "backup-now", CancellationToken.None);
            await BackupSvc.CreateBackupAsync($"manual ({_email})", CancellationToken.None);
            Refresh();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmRestoreAsync(BackupInfo b)
    {
        if (!await _confirm.Show($"Restore {b.FileName}?",
            "Restores this world save. Only allowed while the server is stopped. Current save is snapshotted first."))
            return;

        _busy = true; _error = null;
        try
        {
            await Guard.EnsureAdminAsync(_email, "restore", CancellationToken.None);
            await BackupSvc.RestoreAsync(b.FileName, CancellationToken.None);
            Refresh();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    public void Dispose() { if (_rt is not null) _rt.Supervisor.StateChanged -= OnStateChanged; }
}
