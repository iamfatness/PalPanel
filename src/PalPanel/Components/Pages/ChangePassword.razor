@page "/change-password"
@using Microsoft.EntityFrameworkCore
@using PalPanel.Data
@inject IDbContextFactory<PanelDb> DbFactory
@inject AuthenticationStateProvider AuthState

@* Deliberately no [AllowAnonymous]: this page requires an authenticated user, both because it
   only makes sense for someone already signed in and because Program.cs's FallbackPolicy
   (RequireAuthenticatedUser) is exactly the gate we want here -- unlike Login.razor/Setup.razor,
   which must render before a session exists. *@

<PageTitle>PalPanel — Change password</PageTitle>

<div class="login-shell">
    <div class="login-card">
        <h1>@(_mustChange ? "Set a new password" : "Change password")</h1>
        @if (_mustChange)
        {
            <p class="login-hint">Your password was reset by an admin. Choose a new password to continue.</p>
        }

        @if (Error == "1")
        {
            <div class="alert">Current password incorrect, new password too short, or the new passwords don't match.</div>
        }

        <form method="post" action="/auth/change-password">
            <AntiforgeryToken />
            @if (!_mustChange)
            {
                <label>
                    Current password
                    <input type="password" name="currentPassword" autocomplete="current-password" required />
                </label>
            }
            <label>
                New password
                <input type="password" name="newPassword" autocomplete="new-password" required minlength="8" />
            </label>
            <label>
                Confirm new password
                <input type="password" name="confirmPassword" autocomplete="new-password" required minlength="8" />
            </label>
            <button type="submit" class="primary">Save password</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool _mustChange;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var email = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
        if (string.IsNullOrWhiteSpace(email)) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var user = await db.Users.FirstOrDefaultAsync(u => u.Email == email);
        _mustChange = user?.MustChangePassword ?? false;
    }
}
