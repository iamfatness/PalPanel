{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Panel": {
    "ServerExePath": "C:\\PalServer\\PalServer.exe",
    "ServerArgs": "-publiclobby",
    "ServerProcessName": "PalServer",
    "SaveDirectory": "C:\\PalServer\\Pal\\Saved",
    "BackupDirectory": "C:\\PalPanel\\Backups",
    "BackupsToKeep": 20,
    "ApiBaseUrl": "http://localhost:8212",
    "AdminPassword": "",
    "GracefulStopTimeoutSeconds": 60,
    "CrashWindowMinutes": 10,
    "MaxCrashesInWindow": 3,
    "PollIntervalSeconds": 10,
    "DbPath": "palpanel.db",
    "AuthDisabled": false,
    "GoogleClientId": "",
    "GoogleClientSecret": "",
    "CookieDaysValid": 7
  },
  "Alerts": {
    "_comment": "OPTIONAL one-time seed for email alerts. Configure email in the UI instead (Alerts page → Email settings); the password is stored encrypted in the DB. This section only seeds the DB row on first run if present, so leave it blank unless migrating an old file-based setup.",
    "EmailEnabled": false,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "From": "",
    "To": ""
  }
}
