{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Panel": {
    "ServerExePath": "C:\\PalServer\\PalServer.exe",
    "ServerArgs": "-publiclobby",
    "ServerProcessName": "PalServer",
    "SaveDirectory": "C:\\PalServer\\Pal\\Saved",
    "BackupDirectory": "C:\\PalPanel\\Backups",
    "BackupsToKeep": 20,
    "ApiBaseUrl": "http://localhost:8212",
    "AdminPassword": "",
    "GracefulStopTimeoutSeconds": 60,
    "CrashWindowMinutes": 10,
    "MaxCrashesInWindow": 3,
    "PollIntervalSeconds": 10,
    "DbPath": "palpanel.db",
    "AuthDisabled": false,
    "GoogleClientId": "",
    "GoogleClientSecret": "",
    "CookieDaysValid": 7
  },
  "Alerts": {
    "_comment": "Email push for crash/health alerts. Put real values (esp. SmtpPassword — a Gmail APP password, NOT your account password) in the gitignored appsettings.Local.json, never here. In-panel alerts work regardless.",
    "EmailEnabled": false,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "From": "",
    "To": ""
  }
}
